    "unparsed": 0,
    "cache_files_total": 29
   },
   "after": "store_bars(BANKNIFTY, 2026-11-23, 60800, PE, 2026-11-13) = 76 bars 09:15-15:30 source 'fetched'; store_bars(NIFTY, 2026-11-23, 23600, CE, 2026-11-03) = 77 bars. fetch_premium CACHED path exercised post-edit: ('CACHED', 76).",
   "monday_only": "The first fresh-fetch mirror-write in the live chain (verified code path; fires only when a new contract is fetched)."
  },
  "constraints_honoured": "No job timing changed; no running book's logic changed; no ledger format changed (fetch layer + additive files only)."
